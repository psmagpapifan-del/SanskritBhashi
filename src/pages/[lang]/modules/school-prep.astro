---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import NcertAbout from "../../../components/NcertAbout.astro";
import { getTranslation } from "../../../lib/i18n";
import { ncertChapters } from "../../../lib/ncertContent";
import { NCERT_CLASSES, booksFor, chaptersFor, classSlug, BOOK_LATIN } from "../../../lib/ncertClasses";
import { ncertPageText } from "../../../lib/ncertPageText";
import { GraduationCap } from "lucide-react";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;
const t = getTranslation(lang);

const pt = ncertPageText(lang);
const classCards = NCERT_CLASSES.map((n) => {
  const ch = chaptersFor(n);
  return { n, books: booksFor(n), lessons: ch.length, questions: ch.reduce((q, c) => q + c.questions.length, 0), chapters: ch };
});
const questionCount = ncertChapters.reduce((n, c) => n + c.questions.length, 0);

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "NCERT Sanskrit (दीपकम्, शारदा, शेमुषी, भास्वती, शाश्वती) Classes 6–12: chapter-wise practice and exam quizzes",
  "description": t.schoolPrep.desc,
  "inLanguage": ["sa", lang],
  "educationalLevel": "Middle, secondary and senior secondary school (CBSE Classes 6–12)",
  "provider": {
    "@type": "Organization",
    "name": "Sanskritbhashi",
    "url": "https://sanskritbhashi.com"
  },
  "hasPart": classCards.map((c) => ({
    "@type": "Course",
    "name": `NCERT Sanskrit Class ${c.n} (${c.books.join(", ")})`,
    "url": `https://sanskritbhashi.com/${lang}/modules/school-prep/${classSlug(c.n)}`,
  })),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which NCERT Sanskrit textbooks does School Prep cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `School Prep covers every lesson of the new NCERT Sanskrit textbooks दीपकम् (Deepakam, Classes 6–8), शारदा (Śāradā, Class 9) , शेमुषी (Śemuṣī, Class 10), and भास्वती and शाश्वती (Bhāsvatī and Śāśvatī, Classes 11–12) — ${ncertChapters.length} lessons with ${questionCount} questions.`
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Practice mode and Exam mode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Practice mode gives instant feedback and hints, lets you retry, and asks the questions you missed again at the end. Exam mode gives one attempt per question with no hints; a score of 80% or more passes the chapter. Only your first attempt counts towards the score."
      }
    },
    {
      "@type": "Question",
      "name": "How does the review schedule work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each question uses spaced repetition: a correct first answer moves it to a longer review interval (1, 3, 7, 16 and 35 days), while a miss brings it back the next day. Questions due for review are asked first."
      }
    }
  ]
};
---

<Layout lang={lang} title={`${t.schoolPrep.title} | Sanskritbhashi`} description={t.schoolPrep.desc} showAds={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(courseSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <div class="w-full space-y-6">
    <header class="bg-linear-to-r from-saffron-500 to-marigold-500 rounded-3xl p-6 md:p-8 text-zinc-900 shadow-md">
      <div class="flex items-center gap-3 mb-2">
        <GraduationCap class="w-8 h-8 text-marigold-500" />
        <h1 class="text-2xl md:text-3xl font-bold font-latin">{t.schoolPrep.title}</h1>
      </div>
      <p class="text-sm md:text-base text-zinc-900 max-w-3xl leading-relaxed font-latin">{t.schoolPrep.desc}</p>
    </header>

    <section aria-labelledby="choose-class" class="space-y-4">
      <h2 id="choose-class" class="text-xl font-bold text-charcoal font-latin">{pt.chooseClass}</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {classCards.map((c) => (
          <li>
            <a
              href={`/${lang}/modules/school-prep/${classSlug(c.n)}`}
              data-class-link={c.n}
              class="group block h-full bg-white dark:bg-zinc-900 border border-saffron-100 dark:border-zinc-800 rounded-3xl p-5 hover:border-saffron-500 hover:shadow-md transition-all"
            >
              <span class="block text-lg font-black text-charcoal font-latin">{pt.classLabel(c.n)}</span>
              <span lang="sa" class="block mt-1 font-sanskrit text-base font-semibold text-saffron-600">{c.books.join(" · ")}</span>
              <span class="block text-xs text-charcoal/70 font-latin">{c.books.map((b) => BOOK_LATIN[b] ?? b).join(" · ")}</span>
              <span class="block mt-3 text-xs font-semibold text-charcoal/80 font-latin">{pt.lessons(c.lessons)} · {pt.questions(c.questions)}</span>
              <span class="inline-block mt-3 text-sm font-bold text-saffron-600 group-hover:text-saffron-700 dark:group-hover:text-saffron-300 font-latin">{pt.start} →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="bg-white dark:bg-zinc-900 border border-saffron-100 dark:border-zinc-800 rounded-3xl p-6 space-y-6">
      <NcertAbout lang={lang} />

      <div class="space-y-4">
        {classCards.map((c) => (
          <div>
            <h3 class="text-sm font-black uppercase tracking-widest text-charcoal/70 font-latin">
              <a href={`/${lang}/modules/school-prep/${classSlug(c.n)}`} class="hover:text-saffron-700 dark:hover:text-saffron-300">{pt.classLabel(c.n)} · {c.books.join(" · ")}</a>
            </h3>
            <ol class="mt-2 grid md:grid-cols-2 gap-x-6 gap-y-1.5 text-xs md:text-sm text-charcoal/80 font-latin">
              {c.chapters.map((ch) => (
                <li>
                  <a href={`/${lang}/modules/school-prep/${classSlug(c.n)}?topic=${ch.id}`} class="hover:text-saffron-700 dark:hover:text-saffron-300">
                    <span lang="sa" class="font-sanskrit font-semibold text-charcoal">{ch.title}</span>
                    <span class="text-charcoal/70"> — {ch.summary}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- Old links (/modules/school-prep?topic=c8-05) and app deep links go to the class page. -->
  <script is:inline>
    (function () {
      var t = new URLSearchParams(location.search).get("topic");
      var m = t && /^c(6|7|8|9|10|11|12)-[a-z0-9-]{1,30}$/.exec(t);
      if (!m) return;
      var html = /\.html$/.test(location.pathname);
      var base = location.pathname.replace(/\.html$/, "").replace(/\/$/, "");
      location.replace(base + "/class-" + m[1] + (html ? ".html" : "") + "?topic=" + encodeURIComponent(t));
    })();
  </script>
</Layout>
