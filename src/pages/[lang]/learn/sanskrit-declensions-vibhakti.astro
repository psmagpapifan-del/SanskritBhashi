---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import { ChevronLeft } from "lucide-react";
import ArticleByline from "../../../components/ArticleByline.astro";
import En from "../../../components/articles/sanskrit-declensions-vibhakti/en.astro";
import Hi from "../../../components/articles/sanskrit-declensions-vibhakti/hi.astro";
import Ja from "../../../components/articles/sanskrit-declensions-vibhakti/ja.astro";
import Es from "../../../components/articles/sanskrit-declensions-vibhakti/es.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;

const title = lang === "en"
  ? "Understanding Noun Cases: The Sanskrit Vibhakti System"
  : lang === "hi"
  ? "संज्ञा विभक्तियों को समझना: संस्कृत विभक्ति और कारक प्रणाली"
  : lang === "ja"
  ? "サンスクリットの名詞格変化（ヴィバクティ）とカーラカ（格関係）の基礎"
  : "Comprendiendo los Casos Nominales: El Sistema Vibhakti en Sánscrito";

const desc = lang === "en"
  ? "A comprehensive guide to the 8 Sanskrit noun cases, their semantic functions, and declension paradigms for rāma and latā stems."
  : lang === "hi"
  ? "८ संस्कृत संज्ञा विभक्तियों, उनके अर्थ कार्यों, और राम तथा लता शब्दों के रूप रूपों पर एक विस्तृत मार्गदर्शिका।"
  : lang === "ja"
  ? "8つのサンスクリット名詞の格変化規則、格関係（カーラカ）、および基本名詞「ラーマ」「ラター」の格変化変化表の解説。"
  : "Una guía completa de los 8 casos nominales del sánscrito, sus funciones semánticas y paradigmas de declinación.";

const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<Layout lang={lang} title={title} description={desc}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {/* Navigation link back */}
    <div class="mb-8">
      <a 
        href={`/${lang}/learn`} 
        class="inline-flex items-center space-x-2 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 font-latin uppercase tracking-wider"
      >
        <ChevronLeft class="w-4 h-4" />
        <span>{lang === "en" ? "Back to Learning Hub" : lang === "hi" ? "अध्ययन केंद्र पर वापस" : lang === "ja" ? "学習ハブに戻る" : "Volver al Centro de Aprendizaje"}</span>
      </a>
    </div>

    <Body />
    <ArticleByline lang={lang} slug="sanskrit-declensions-vibhakti" title={title} description={desc} published="2026-07-24" updated="2026-11-18" />
  </div>
</Layout>
