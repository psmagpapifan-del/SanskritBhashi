---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import NcertQuiz from "../../../components/NcertQuiz";
import { getTranslation } from "../../../lib/i18n";
import { ncertChapters } from "../../../lib/ncertContent";
import { GraduationCap } from "lucide-react";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;
const t = getTranslation(lang);

const classes = [...new Set(ncertChapters.map((c) => c.group!))];
const questionCount = ncertChapters.reduce((n, c) => n + c.questions.length, 0);

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "NCERT Sanskrit (दीपकम्, शारदा, शेमुषी) Classes 6–10: chapter-wise practice and exam quizzes",
  "description": t.schoolPrep.desc,
  "inLanguage": ["sa", lang],
  "educationalLevel": "Middle and secondary school (CBSE Classes 6–10)",
  "provider": {
    "@type": "Organization",
    "name": "Sanskritbhashi",
    "url": "https://sanskritbhashi.com"
  },
  "hasPart": ncertChapters.map((c) => ({
    "@type": "LearningResource",
    "name": `${c.text}: ${c.title}`,
    "description": c.summary,
  })),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which NCERT Sanskrit textbooks does School Prep cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `School Prep covers every lesson of the new NCERT Sanskrit textbooks दीपकम् (Deepakam, Classes 6–8), शारदा (Śāradā, Class 9) and शेमुषी (Śemuṣī, Class 10) — ${ncertChapters.length} lessons with ${questionCount} questions. Classes 11–12 are being added next.`
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Practice mode and Exam mode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Practice mode gives instant feedback and hints, lets you retry, and asks the questions you missed again at the end. Exam mode gives one attempt per question with no hints; a score of 80% or more passes the chapter. Only your first attempt counts towards the score."
      }
    },
    {
      "@type": "Question",
      "name": "How does the review schedule work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each question uses spaced repetition: a correct first answer moves it to a longer review interval (1, 3, 7, 16 and 35 days), while a miss brings it back the next day. Questions due for review are asked first."
      }
    }
  ]
};
---

<Layout lang={lang} title={`${t.schoolPrep.title} | Sanskritbhashi`} description={t.schoolPrep.desc} showAds={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(courseSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <div class="w-full space-y-6">
    <header class="bg-linear-to-r from-saffron-500 to-saffron-600 rounded-3xl p-6 md:p-8 text-white shadow-md">
      <div class="flex items-center gap-3 mb-2">
        <GraduationCap class="w-8 h-8 text-marigold-500" />
        <h1 class="text-2xl md:text-3xl font-bold font-latin">{t.schoolPrep.title}</h1>
      </div>
      <p class="text-sm md:text-base text-white/95 max-w-3xl leading-relaxed font-latin">{t.schoolPrep.desc}</p>
    </header>

    <NcertQuiz client:load activeLang={lang} />

    <section class="bg-white dark:bg-zinc-900 border border-saffron-100 dark:border-zinc-800 rounded-3xl p-6 space-y-6">
      {lang === "hi" ? (
        <>
          <h2 class="text-xl font-bold text-charcoal font-latin">एनसीईआरटी संस्कृत (दीपकम्) — पाठ-अनुसार अभ्यास</h2>
          <div class="prose dark:prose-invert text-xs md:text-sm text-charcoal/80 space-y-4 leading-relaxed font-latin">
            <p>स्कूल प्रेप मॉड्यूल एनसीईआरटी की नई संस्कृत पाठ्यपुस्तकों <strong>दीपकम्</strong> (कक्षा 6, 7, 8), <strong>शारदा</strong> (कक्षा 9) और <strong>शेमुषी</strong> (कक्षा 10) के हर पाठ पर आधारित है। प्रत्येक पाठ में 7–9 प्रश्न हैं, जो सीधे पाठ्यपुस्तक के पाठ से लिए गए हैं: अर्थ, व्याकरण (शब्दरूप, धातुरूप, लकार), सन्धि, संख्याएँ, शब्दार्थ और पाठ-बोध।</p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>अभ्यास मोड:</strong> तुरंत प्रतिक्रिया और संकेत; गलत उत्तर के बाद फिर प्रयास करें। चूके हुए प्रश्न अंत में दोबारा पूछे जाते हैं।</li>
              <li><strong>परीक्षा मोड:</strong> प्रत्येक प्रश्न का एक ही प्रयास, कोई संकेत नहीं। 80% या अधिक अंक पर पाठ उत्तीर्ण।</li>
              <li><strong>पुनरावृत्ति:</strong> प्रत्येक प्रश्न अंतराल-पुनरावृत्ति (1, 3, 7, 16, 35 दिन) से दोहराया जाता है, ताकि पढ़ा हुआ याद रहे।</li>
            </ul>
            <p>सभी पाठ हर विद्यार्थी के लिए खुले हैं — कोई ताला नहीं। संस्कृत शब्द आपकी चुनी हुई लिपि (देवनागरी, IAST, कताकाना या फ़्रेंच) में दिखते हैं। कक्षा 11–12 के पाठ जल्द जोड़े जाएँगे।</p>
          </div>
        </>
      ) : lang === "ja" ? (
        <>
          <h2 class="text-xl font-bold text-charcoal font-latin">NCERT サンスクリット（ディーパカム）— 章ごとの練習</h2>
          <div class="prose dark:prose-invert text-xs md:text-sm text-charcoal/80 space-y-4 leading-relaxed font-latin">
            <p>スクールプレップは、NCERT の新しい教科書<strong>『ディーパカム』</strong>（6〜8年生）、<strong>『シャーラダー』</strong>（9年生）、<strong>『シェームシー』</strong>（10年生）の全課に基づいています。各課には教科書本文から作られた7〜9問があり、意味、文法（名詞・動詞の変化、時制）、連声（サンディ）、数、語彙、読解を扱います。</p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>練習モード：</strong>すぐにフィードバックとヒントが表示され、やり直しができます。間違えた問題は最後にもう一度出題されます。</li>
              <li><strong>試験モード：</strong>各問題1回のみ、ヒントなし。80%以上で合格です。</li>
              <li><strong>復習：</strong>各問題は間隔反復（1・3・7・16・35日）で復習され、学んだ内容が定着します。</li>
            </ul>
            <p>すべての課は誰でもすぐに学べます。サンスクリット語は選択した文字（デーヴァナーガリー、IAST、カタカナ、フランス語式）で表示されます。11〜12年生の内容も順次追加予定です。</p>
          </div>
        </>
      ) : lang === "es" ? (
        <>
          <h2 class="text-xl font-bold text-charcoal font-latin">Sánscrito NCERT (Dīpakam): práctica por capítulos</h2>
          <div class="prose dark:prose-invert text-xs md:text-sm text-charcoal/80 space-y-4 leading-relaxed font-latin">
            <p>School Prep se basa en cada lección de los nuevos libros de texto NCERT <strong>दीपकम् (Dīpakam)</strong> para las Clases 6, 7 y 8 , <strong>शारदा (Śāradā)</strong> para la Clase 9 y <strong>शेमुषी (Śemuṣī)</strong> para la Clase 10. Cada lección tiene de 7 a 9 preguntas escritas a partir del propio texto: significado, gramática (declinaciones, conjugaciones, tiempos), sandhi, números, vocabulario y comprensión.</p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Modo práctica:</strong> respuesta inmediata y pistas; puede volver a intentarlo. Las preguntas falladas vuelven al final.</li>
              <li><strong>Modo examen:</strong> un intento por pregunta y sin pistas. Con 80% o más se aprueba la lección.</li>
              <li><strong>Repaso:</strong> cada pregunta se repasa con repetición espaciada (1, 3, 7, 16 y 35 días) para fijar lo aprendido.</li>
            </ul>
            <p>Todas las lecciones están abiertas desde el principio. Las palabras sánscritas se muestran en la escritura elegida (devanagari, IAST, katakana o francés). Las Clases 11 y 12 se añadirán pronto.</p>
          </div>
        </>
      ) : (
        <>
          <h2 class="text-xl font-bold text-charcoal font-latin">NCERT Sanskrit (दीपकम्) — chapter-wise practice</h2>
          <div class="prose dark:prose-invert text-xs md:text-sm text-charcoal/80 space-y-4 leading-relaxed font-latin">
            <p>School Prep follows every lesson of the new NCERT Sanskrit textbooks <strong>दीपकम् (Deepakam)</strong> for Classes 6, 7 and 8 , <strong>शारदा (Śāradā)</strong> for Class 9 and <strong>शेमुषी (Śemuṣī)</strong> for Class 10. Each lesson has 7–9 questions written from the textbook itself: meaning, grammar (noun and verb forms, lakāras), sandhi, numbers, vocabulary and comprehension of the passage.</p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Practice mode:</strong> instant feedback and hints; try again after a wrong answer. Questions you miss come back at the end of the round.</li>
              <li><strong>Exam mode:</strong> one attempt per question, no hints. Score 80% or more to pass the lesson.</li>
              <li><strong>Review:</strong> every question is scheduled with spaced repetition (1, 3, 7, 16 and 35 days), so what you learn stays learned.</li>
            </ul>
            <p>Every lesson is open from the start — there are no locks. Sanskrit words appear in the script you choose in the language menu (Devanagari, IAST, Katakana or French phonetic). Classes 11–12 are coming next.</p>
          </div>
        </>
      )}

      <div class="space-y-4">
        {classes.map((cls) => (
          <div>
            <h3 class="text-sm font-black uppercase tracking-widest text-charcoal/70 font-latin">{cls} · {ncertChapters.find((c) => c.group === cls)!.text.split(" · ")[1]}</h3>
            <ol class="mt-2 grid md:grid-cols-2 gap-x-6 gap-y-1.5 text-xs md:text-sm text-charcoal/80 font-latin">
              {ncertChapters.filter((c) => c.group === cls).map((c) => (
                <li>
                  <a href={`?topic=${c.id}`} class="hover:text-saffron-700 dark:hover:text-saffron-300">
                    <span lang="sa" class="font-sanskrit font-semibold text-charcoal">{c.title}</span>
                    <span class="text-charcoal/70"> — {c.summary}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
