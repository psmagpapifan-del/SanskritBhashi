---
export const prerender = true;
import { Info, ShieldCheck, Award, Mail } from "lucide-react";
import Layout from "../../layouts/Layout.astro";
import { getTranslation } from "../../lib/i18n";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;
const t = getTranslation(lang);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Sanskritbhashi",
  "url": "https://sanskritbhashi.com",
  "description": t.about.desc,
  "knowsAbout": ["Sanskrit Grammar", "Paninian Linguistics", "Bhagavad Gita", "NCERT Syllabus"],
  "founder": {
    "@type": "Person",
    "name": "Prashant Solanki"
  }
};
---

<Layout lang={lang} title={`${t.nav.about} | Sanskritbhashi`} description={t.about.desc}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgSchema)} />

  {/* Header Banner */}
  <section class="bg-linear-to-r from-brand-500 to-accent-500 rounded-3xl p-6 md:p-8 text-on-brand mb-8 shadow-md">
    <div class="flex items-center gap-3 mb-2">
      <Info class="w-8 h-8 text-accent-500" />
      <h1 class="text-2xl md:text-3xl font-bold font-latin">{t.about.title}</h1>
    </div>
    <p class="text-sm md:text-base text-on-brand max-w-2xl leading-relaxed font-latin">
      {t.about.desc}
    </p>
    <div class="mt-4 flex flex-wrap gap-4 text-xs font-semibold text-on-brand">
      <span class="flex items-center gap-1.5 bg-white/30 px-3 py-1 rounded-full border border-on-brand/10 font-mono">
        <Mail class="w-3.5 h-3.5" /> {t.about.contactLabel}: ps.magpapifan@gmail.com
      </span>
    </div>
  </section>

  {/* Main Content Sections with GEO optimization */}
  <div class="bg-white dark:bg-zinc-900 border border-border-hairline rounded-3xl p-6 md:p-8 space-y-8 max-w-4xl mx-auto">
    
    {/* Mission & Academic Authority */}
    <section class="space-y-4">
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-6 h-6 text-brand-500" />
        <h2 class="text-xl md:text-2xl font-bold text-charcoal font-latin">{t.about.authorityTitle}</h2>
      </div>
      <p class="text-sm md:text-base text-charcoal/70 leading-relaxed font-latin">
        {t.about.authorityDesc}
      </p>

      <div class="border-t border-border-hairline pt-4 space-y-6">
        <div>
          <h3 class="text-base font-bold text-brand-600 dark:text-brand-500 font-latin">
            {t.about.q1}
          </h3>
          <p class="text-sm leading-relaxed text-charcoal/80 font-latin mt-1">
            {t.about.a1}
          </p>
        </div>

        <div>
          <h3 class="text-base font-bold text-brand-600 dark:text-brand-500 font-latin">
            {t.about.q2}
          </h3>
          <p class="text-sm leading-relaxed text-charcoal/80 font-latin mt-1">
            {t.about.a2}
          </p>
        </div>

        <div>
          <h3 class="text-base font-bold text-brand-600 dark:text-brand-500 font-latin">
            {t.about.q3}
          </h3>
          <p class="text-sm leading-relaxed text-charcoal/80 font-latin mt-1">
            {t.about.a3}
          </p>
        </div>
      </div>
    </section>

    {/* Who makes the site */}
    <section class="border-t border-border-hairline pt-6 space-y-4">
      <div class="flex items-center gap-2">
        <Award class="w-6 h-6 text-brand-500" />
        <h2 class="text-xl md:text-2xl font-bold text-charcoal font-latin">{t.about.creatorTitle}</h2>
      </div>
      <div class="bg-cream/50 dark:bg-zinc-950/50 p-6 rounded-2xl border border-border-hairline space-y-2">
        <div class="flex flex-wrap items-baseline gap-2">
          <h3 class="font-extrabold text-charcoal text-base font-latin">{lang === "hi" ? "प्रशांत सोलंकी" : "Prashant Solanki"}</h3>
          <span class="text-xs font-semibold text-brand-600 dark:text-brand-500 font-mono">{t.about.creatorRole}</span>
        </div>
        <p class="text-sm text-charcoal/70 leading-relaxed font-latin">{t.about.creatorDesc}</p>
        <div class="text-xs font-bold text-charcoal/70 font-mono flex items-center gap-1.5 pt-1">
          <Mail class="w-3.5 h-3.5 text-brand-500" /> {t.about.contactLabel}:
          <a href="mailto:ps.magpapifan@gmail.com" class="text-brand-600 dark:text-brand-500 underline hover:text-brand-400">ps.magpapifan@gmail.com</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
