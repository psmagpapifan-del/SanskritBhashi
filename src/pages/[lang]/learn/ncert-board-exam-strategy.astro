---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import { ChevronLeft } from "lucide-react";
import ArticleByline from "../../../components/ArticleByline.astro";
import En from "../../../components/articles/ncert-board-exam-strategy/en.astro";
import Hi from "../../../components/articles/ncert-board-exam-strategy/hi.astro";
import Ja from "../../../components/articles/ncert-board-exam-strategy/ja.astro";
import Es from "../../../components/articles/ncert-board-exam-strategy/es.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;

const title = lang === "en"
  ? "NCERT Sanskrit Board Exams: Proven Study and Writing Strategies"
  : lang === "hi"
  ? "एनसीईआरटी संस्कृत बोर्ड परीक्षा: शत-प्रतिशत अंक प्राप्त करने की सिद्ध रणनीतियाँ"
  : lang === "ja"
  ? "NCERTサンスクリット試験対策：高得点を獲得するための学習法と解答テクニック"
  : "Exámenes de Sánscrito de NCERT: Estrategias de Estudio y Escritura";

const desc = lang === "en"
  ? "A comprehensive preparation guide for CBSE Class 10 Sanskrit, covering grammar, reading comprehension, and writing skills."
  : lang === "hi"
  ? "सीबीएसई कक्षा 10 संस्कृत परीक्षा के लिए एक व्यापक तैयारी गाइड, जिसमें व्याकरण, अपठित गद्यांश और पत्र लेखन शामिल है।"
  : lang === "ja"
  ? "CBSEクラス10およびNCERTサンスクリット試験に向けた対策ガイド。読解問題、作文、応用文法の攻略法を伝授します。"
  : "Una guía de preparación completa para el examen de sánscrito de la Clase 10 de CBSE y NCERT.";

const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<Layout lang={lang} title={title} description={desc}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {/* Navigation link back */}
    <div class="mb-8">
      <a 
        href={`/${lang}/learn`} 
        class="inline-flex items-center space-x-2 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 font-latin uppercase tracking-wider"
      >
        <ChevronLeft class="w-4 h-4" />
        <span>{lang === "en" ? "Back to Learning Hub" : lang === "hi" ? "अध्ययन केंद्र पर वापस" : lang === "ja" ? "学習ハブに戻る" : "Volver al Centro de Aprendizaje"}</span>
      </a>
    </div>

    <Body />
    <ArticleByline lang={lang} slug="ncert-board-exam-strategy" title={title} description={desc} published="2026-07-24" updated="2026-11-18" />
  </div>
</Layout>
