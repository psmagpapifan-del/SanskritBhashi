---
/** Number and clock-time tables shared by every language version. */
import Table from "../Table.astro";

interface Props {
  kind: "cardinals" | "teens" | "tens" | "gender" | "ordinals" | "time";
  headers: string[];
  /** Optional translations for the last column (same length as the rows). */
  notes?: string[];
}

const data: Record<Props["kind"], string[][]> = {
  cardinals: [
    ["१", "एकम्"], ["२", "द्वे"], ["३", "त्रीणि"], ["४", "चत्वारि"], ["५", "पञ्च"],
    ["६", "षट्"], ["७", "सप्त"], ["८", "अष्ट / अष्टौ"], ["९", "नव"], ["१०", "दश"],
  ],
  teens: [
    ["११", "एकादश"], ["१२", "द्वादश"], ["१३", "त्रयोदश"], ["१४", "चतुर्दश"], ["१५", "पञ्चदश"],
    ["१६", "षोडश"], ["१७", "सप्तदश"], ["१८", "अष्टादश"], ["१९", "नवदश / एकोनविंशतिः"], ["२०", "विंशतिः"],
  ],
  tens: [
    ["३०", "त्रिंशत्"], ["४०", "चत्वारिंशत्"], ["५०", "पञ्चाशत्"], ["६०", "षष्टिः"], ["७०", "सप्ततिः"],
    ["८०", "अशीतिः"], ["९०", "नवतिः"], ["१००", "शतम्"], ["१०००", "सहस्रम्"],
  ],
  gender: [
    ["१", "एकः", "एका", "एकम्"],
    ["२", "द्वौ", "द्वे", "द्वे"],
    ["३", "त्रयः", "तिस्रः", "त्रीणि"],
    ["४", "चत्वारः", "चतस्रः", "चत्वारि"],
  ],
  ordinals: [
    ["१", "प्रथमः", "प्रथमा"], ["२", "द्वितीयः", "द्वितीया"], ["३", "तृतीयः", "तृतीया"],
    ["४", "चतुर्थः", "चतुर्थी"], ["५", "पञ्चमः", "पञ्चमी"], ["६", "षष्ठः", "षष्ठी"],
    ["७", "सप्तमः", "सप्तमी"], ["८", "अष्टमः", "अष्टमी"], ["९", "नवमः", "नवमी"], ["१०", "दशमः", "दशमी"],
  ],
  time: [
    ["5:00", "पञ्चवादनम्"],
    ["5:15", "सपादपञ्चवादनम्"],
    ["5:30", "सार्धपञ्चवादनम्"],
    ["4:45", "पादोनपञ्चवादनम्"],
    ["5:10", "दशाधिकपञ्चवादनम्"],
    ["4:50", "दशोनपञ्चवादनम्"],
    ["7:20", "विंशत्यधिकसप्तवादनम्"],
    ["6:00", "षड्वादनम्"],
  ],
};

const { kind, headers, notes } = Astro.props;
const rows = data[kind].map((r, i) => (notes ? [...r, notes[i] ?? ""] : r));
---

<Table headers={headers} rows={rows} sanskrit />
