---
export const prerender = true;
import Layout from "../../../../layouts/Layout.astro";
import GitaStudy from "../../../../components/gita/GitaStudy";
import { getTranslation } from "../../../../lib/i18n";
import { GITA_AVAILABLE, adhyayaSlug } from "../../../../lib/gita/index";
import { getLocalAdhyaya, gitaLocales, isTranslated } from "../../../../lib/gita/content";
import { fitTitle, gitaPageText } from "../../../../lib/gitaPageText";

export function getStaticPaths() {
  return ["en", "hi", "ja", "es"].flatMap((lang) =>
    GITA_AVAILABLE.map((n) => ({ params: { lang, adhyaya: adhyayaSlug(n) }, props: { n } }))
  );
}

const { lang } = Astro.params;
const { n } = Astro.props as { n: number };
// The chapter in this page's language (English if ja/es isn't translated yet); only this goes to the browser.
const a = getLocalAdhyaya(n, lang);
const cl = a.lang;
const translated = isTranslated(n, lang);
const nav = getTranslation(lang);
const t = gitaPageText(lang);
const ct = gitaPageText(cl);
const available = GITA_AVAILABLE as readonly number[];
const prev = available.includes(n - 1) ? n - 1 : null;
const next = available.includes(n + 1) ? n + 1 : null;

// Keep titles within ~70 characters (what search results show): optional parts are dropped if too long.
const title = fitTitle(ct.pageTitleParts(n, a.title));
const description = ct.pageDesc(n, a.name, a.shlokas.map((s) => s.ref).join(", "));

const schema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": title.replace(/ \| Sanskritbhashi$/, ""),
  "description": description,
  "inLanguage": ["sa", cl],
  "educationalLevel": "Classes 6–12",
  "learningResourceType": "Lesson",
  "isPartOf": { "@type": "Course", "name": ct.courseName, "url": `https://sanskritbhashi.com/${cl}/modules/gita` },
  "about": a.shlokas.map((s) => ({ "@type": "CreativeWork", "name": `Bhagavad Gītā ${s.ref}` })),
};
---

<Layout
  lang={lang}
  title={title}
  description={description}
  showAds={false}
  locales={gitaLocales(n)}
  noindex={!translated}
  canonicalPath={translated ? undefined : `/en/modules/gita/${adhyayaSlug(n)}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="w-full space-y-6">
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-charcoal/70 font-latin">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={`/${lang}/modules/gita`} class="hover:text-brand-700 dark:hover:text-brand-300">{nav.nav.gita}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-charcoal">{t.adhyaya(n)}</li>
      </ol>
    </nav>

    <header class="bg-linear-to-r from-brand-500 to-accent-500 rounded-3xl p-6 md:p-8 text-on-brand shadow-md">
      <p class="text-xs font-black uppercase tracking-widest font-latin">{t.adhyaya(n)}</p>
      <h1 class="mt-1 text-2xl md:text-3xl font-bold font-latin">
        <span lang="sa" class="font-sanskrit">{a.name}</span> · {a.title}
      </h1>
    </header>

    {!translated ? <p class="text-sm text-charcoal/80 font-latin bg-brand-50 dark:bg-zinc-900 border border-brand-100 dark:border-zinc-800 rounded-2xl px-4 py-3">{t.languageNote}</p> : t.translatedNote && <p class="text-xs text-charcoal/70 font-latin">{t.translatedNote}</p>}

    <section class="grid md:grid-cols-5 gap-4">
      <div class="md:col-span-3 bg-white dark:bg-zinc-900 border border-brand-100 dark:border-zinc-800 rounded-3xl p-6">
        <h2 class="text-sm font-black uppercase tracking-widest text-charcoal/70 font-latin">{t.story}</h2>
        <p lang={cl} class="mt-2 text-sm md:text-base text-charcoal leading-relaxed font-latin">{a.context}</p>
      </div>
      <div class="md:col-span-2 bg-white dark:bg-zinc-900 border border-brand-100 dark:border-zinc-800 rounded-3xl p-6">
        <h2 class="text-sm font-black uppercase tracking-widest text-charcoal/70 font-latin">{t.crux}</h2>
        <ol class="mt-2 space-y-2 list-decimal pl-5 text-sm md:text-base text-charcoal font-latin" lang={cl}>
          {a.crux.map((c) => <li>{c}</li>)}
        </ol>
      </div>
    </section>

    <GitaStudy client:load adhyaya={a} activeLang={lang} />

    <nav aria-label={t.chooseAdhyaya} class="flex flex-wrap items-center justify-between gap-3 text-sm font-bold font-latin">
      {prev ? <a href={`/${lang}/modules/gita/${adhyayaSlug(prev)}`} class="text-brand-600 hover:text-brand-700 dark:hover:text-brand-300">← {t.previous}</a> : <span />}
      <a href={`/${lang}/modules/gita`} class="text-charcoal/80 hover:text-brand-700">{t.allAdhyayas}</a>
      {next ? <a href={`/${lang}/modules/gita/${adhyayaSlug(next)}`} class="text-brand-600 hover:text-brand-700 dark:hover:text-brand-300">{t.next} →</a> : <span />}
    </nav>
    <p class="text-xs text-charcoal/70 font-latin">{t.reviewNote}</p>
  </div>
</Layout>
