---
export const prerender = true;
import ArticlePage from "../../../components/ArticlePage.astro";
import En from "../../../components/articles/sanskrit-chandas-meter/en.astro";
import Hi from "../../../components/articles/sanskrit-chandas-meter/hi.astro";
import Ja from "../../../components/articles/sanskrit-chandas-meter/ja.astro";
import Es from "../../../components/articles/sanskrit-chandas-meter/es.astro";

export function getStaticPaths() {
  return ["en", "hi", "ja", "es"].map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<ArticlePage lang={lang} slug="sanskrit-chandas-meter">
  <Body />
</ArticlePage>
