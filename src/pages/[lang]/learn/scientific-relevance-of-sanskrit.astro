---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import { ChevronLeft } from "lucide-react";
import ArticleByline from "../../../components/ArticleByline.astro";
import En from "../../../components/articles/scientific-relevance-of-sanskrit/en.astro";
import Hi from "../../../components/articles/scientific-relevance-of-sanskrit/hi.astro";
import Ja from "../../../components/articles/scientific-relevance-of-sanskrit/ja.astro";
import Es from "../../../components/articles/scientific-relevance-of-sanskrit/es.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;

const title = lang === "en"
  ? "The Computational Structure of Sanskrit: Paninian Grammar and Computer Science"
  : lang === "hi"
  ? "संस्कृत की संगणकीय संरचना: पाणिनीय व्याकरण और कंप्यूटर विज्ञान"
  : lang === "ja"
  ? "サンスクリットの計算言語学的構造：パーニニの文法規則とコンピュータサイエンス"
  : "La Estructura Computacional del Sánscrito: Gramática Paniniana y Ciencia de la Computación";

const desc = lang === "en"
  ? "An academic exploration of Paninian linguistics, its mathematical design, and its parallels to programming languages and compiler theory."
  : lang === "hi"
  ? "पाणिनीय भाषा विज्ञान, इसके गणितीय डिजाइन और प्रोग्रामिंग भाषाओं तथा कंपाइलर सिद्धांत के साथ इसकी समानता का एक अकादमिक अन्वेषण।"
  : lang === "ja"
  ? "パーニニの文法体系アシュターディヤーイーの数学的構造と、現代プログラミング言語の構文定義（BNF）やコンパイラ設計との学術的類似性を解説。"
  : "Una exploración académica de la lingüística paniniana y sus paralelismos con la ciencia de la computación.";

const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<Layout lang={lang} title={title} description={desc}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {/* Navigation link back */}
    <div class="mb-8">
      <a 
        href={`/${lang}/learn`} 
        class="inline-flex items-center space-x-2 text-xs font-bold text-saffron-600 dark:text-saffron-400 hover:text-saffron-700 dark:hover:text-saffron-300 font-latin uppercase tracking-wider"
      >
        <ChevronLeft class="w-4 h-4" />
        <span>{lang === "en" ? "Back to Learning Hub" : lang === "hi" ? "अध्ययन केंद्र पर वापस" : lang === "ja" ? "学習ハブに戻る" : "Volver al Centro de Aprendizaje"}</span>
      </a>
    </div>

    <Body />
    <ArticleByline lang={lang} slug="scientific-relevance-of-sanskrit" title={title} description={desc} published="2026-07-24" updated="2026-11-18" />
  </div>
</Layout>
