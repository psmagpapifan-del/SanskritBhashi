---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import { ChevronLeft } from "lucide-react";
import ArticleByline from "../../../components/ArticleByline.astro";
import En from "../../../components/articles/bhagavad-gita-anvaya-guide/en.astro";
import Hi from "../../../components/articles/bhagavad-gita-anvaya-guide/hi.astro";
import Ja from "../../../components/articles/bhagavad-gita-anvaya-guide/ja.astro";
import Es from "../../../components/articles/bhagavad-gita-anvaya-guide/es.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;

const title = lang === "en"
  ? "The Art of Anvaya: How to Translate and Understand Gita Shlokas"
  : lang === "hi"
  ? "अन्वय की कला: गीता श्लोकों का अनुवाद और अर्थ कैसे समझें"
  : lang === "ja"
  ? "アンヴァヤの極意：バガヴァッド・ギーターの詩節を解読して翻訳する手順"
  : "El Arte de Anvaya: Cómo Traducir y Entender Shlokas del Gita";

const desc = lang === "en"
  ? "A comprehensive tutorial on Dandanvaya and Khandanvaya techniques to restructure Sanskrit verse poetry into prose."
  : lang === "hi"
  ? "संस्कृत श्लोक (कविता) को गद्य में पुनर्गठित करने के लिए दण्डान्वय और खण्डान्वय तकनीकों पर एक व्यापक ट्यूटोरियल।"
  : lang === "ja"
  ? "サンスクリットの韻文（詩節）を散文に再構築するためのダンダンヴァヤおよびカンダンヴァヤ技法に関する解説ガイド。"
  : "Un tutorial completo sobre las técnicas Dandanvaya y Khandanvaya para reestructurar la poesía en prosa sánscrita.";

const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<Layout lang={lang} title={title} description={desc}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {/* Navigation link back */}
    <div class="mb-8">
      <a 
        href={`/${lang}/learn`} 
        class="inline-flex items-center space-x-2 text-xs font-bold text-saffron-600 dark:text-saffron-400 hover:text-saffron-700 dark:hover:text-saffron-300 font-latin uppercase tracking-wider"
      >
        <ChevronLeft class="w-4 h-4" />
        <span>{lang === "en" ? "Back to Learning Hub" : lang === "hi" ? "अध्ययन केंद्र पर वापस" : lang === "ja" ? "学習ハブに戻る" : "Volver al Centro de Aprendizaje"}</span>
      </a>
    </div>

    <Body />
    <ArticleByline lang={lang} slug="bhagavad-gita-anvaya-guide" title={title} description={desc} published="2026-07-24" updated="2026-11-18" module="shastra-study" />
  </div>
</Layout>
