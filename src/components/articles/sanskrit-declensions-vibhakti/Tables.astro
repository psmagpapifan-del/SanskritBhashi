---
/**
 * Shared Vibhakti tables for the localized declension articles.
 * The Sanskrit forms are identical in every language; only the labels change.
 */
interface Props {
  kind: "karaka" | "rama";
  headers: string[];
  /** karaka: 8 rows of [case, kāraka, role, example]. rama: 8 case labels. */
  rows: string[][] | string[];
}

const { kind, headers, rows } = Astro.props;

const ramaForms = [
  ["रामः (rāmaḥ)", "रामौ (rāmau)", "रामाः (rāmāḥ)"],
  ["रामम् (rāmam)", "रामौ (rāmau)", "रामान् (rāmān)"],
  ["रामेण (rāmeṇa)", "रामाभ्याम् (rāmābhyām)", "रामैः (rāmaiḥ)"],
  ["रामाय (rāmāya)", "रामाभ्याम् (rāmābhyām)", "रामेभ्यः (rāmebhyaḥ)"],
  ["रामात् (rāmāt)", "रामाभ्याम् (rāmābhyām)", "रामेभ्यः (rāmebhyaḥ)"],
  ["रामस्य (rāmasya)", "रामयोः (rāmayoḥ)", "रामाणाम् (rāmāṇām)"],
  ["रामे (rāme)", "रामयोः (rāmayoḥ)", "रामेषु (rāmeṣu)"],
  ["हे राम (he rāma)", "हे रामौ (he rāmau)", "हे रामाः (he rāmāḥ)"],
];

const cell = "p-3 border border-brand-100 dark:border-zinc-800";
const tableRows: string[][] =
  kind === "rama"
    ? (rows as string[]).map((label, i) => [label, ...ramaForms[i]])
    : (rows as string[][]);
---

<div class="overflow-x-auto my-6">
  <table class="min-w-full bg-white dark:bg-zinc-900 border border-brand-100 dark:border-zinc-800 text-xs md:text-sm">
    <thead>
      <tr class="bg-brand-50 dark:bg-zinc-800 text-charcoal dark:text-zinc-200 font-bold">
        {headers.map((h) => <th class={`${cell} text-left`}>{h}</th>)}
      </tr>
    </thead>
    <tbody class="text-charcoal/80 dark:text-zinc-400">
      {tableRows.map((row, i) => (
        <tr class={`border-t border-cream dark:border-zinc-800 ${i % 2 ? "bg-cream/20 dark:bg-zinc-850/20" : ""}`}>
          {row.map((value, j) => (
            <td class={`${cell} ${j === 0 ? "font-bold" : kind === "rama" ? "font-semibold font-sanskrit" : ""}`}>{value}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
