---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import { ChevronLeft } from "lucide-react";
import ArticleByline from "../../../components/ArticleByline.astro";
import En from "../../../components/articles/pronunciation-and-devanagari/en.astro";
import Hi from "../../../components/articles/pronunciation-and-devanagari/hi.astro";
import Ja from "../../../components/articles/pronunciation-and-devanagari/ja.astro";
import Es from "../../../components/articles/pronunciation-and-devanagari/es.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;

const title = lang === "en"
  ? "Sanskrit Phonology: Articulation Points and Devanagari Pronunciation"
  : lang === "hi"
  ? "संस्कृत ध्वन्यात्मकता: उच्चारण स्थान और वर्णमाला उच्चारण निर्देश"
  : lang === "ja"
  ? "サンスクリットの音韻論：調音点（発音位置）とデーヴァナーガリー発音ガイド"
  : "Fonología del Sánscrito: Puntos de Articulación y Pronunciación Devanagari";

const desc = lang === "en"
  ? "A comprehensive phonetic guide to the physiological classification of Sanskrit letters and correct Devanagari pronunciation."
  : lang === "hi"
  ? "संस्कृत अक्षरों के शारीरिक वर्गीकरण और सही देवनागरी उच्चारण के लिए एक व्यापक ध्वन्यात्मक गाइड।"
  : lang === "ja"
  ? "サンスクリット文字の調音点に関する音韻ガイド。母音と子音の正しい発音の仕方を詳しく解説します。"
  : "Una guía fonética completa sobre la clasificación fisiológica de las letras sánscritas y la pronunciación correcta.";

const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<Layout lang={lang} title={title} description={desc}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {/* Navigation link back */}
    <div class="mb-8">
      <a 
        href={`/${lang}/learn`} 
        class="inline-flex items-center space-x-2 text-xs font-bold text-saffron-600 dark:text-saffron-400 hover:text-saffron-755 dark:hover:text-saffron-300 font-latin uppercase tracking-wider"
      >
        <ChevronLeft class="w-4 h-4" />
        <span>{lang === "en" ? "Back to Learning Hub" : lang === "hi" ? "अध्ययन केंद्र पर वापस" : lang === "ja" ? "学習ハブに戻る" : "Volver al Centro de Aprendizaje"}</span>
      </a>
    </div>

    <Body />
    <ArticleByline lang={lang} slug="pronunciation-and-devanagari" title={title} description={desc} published="2026-07-24" updated="2026-11-18" />
  </div>
</Layout>
