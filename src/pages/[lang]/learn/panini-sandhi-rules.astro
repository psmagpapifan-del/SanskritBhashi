---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import { ChevronLeft } from "lucide-react";
import ArticleByline from "../../../components/ArticleByline.astro";
import En from "../../../components/articles/panini-sandhi-rules/en.astro";
import Hi from "../../../components/articles/panini-sandhi-rules/hi.astro";
import Ja from "../../../components/articles/panini-sandhi-rules/ja.astro";
import Es from "../../../components/articles/panini-sandhi-rules/es.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "hi" } },
    { params: { lang: "ja" } },
    { params: { lang: "es" } },
  ];
}

const { lang } = Astro.params;

const title = lang === "en" 
  ? "Mastering Sanskrit Sandhi Rules: Vowels, Consonants, and Visargas"
  : lang === "hi"
  ? "संस्कृत संधि नियमों पर महारत: स्वर, व्यंजन और विसर्ग"
  : lang === "ja"
  ? "サンスクリットのサンドゥヒ（連声）規則の完全解説：母音・子音・ヴィサルガ"
  : "Dominando las Reglas de Sandhi en Sánscrito: Vocales, Consonantes y Visargas";

const desc = lang === "en"
  ? "A comprehensive phonetic guide to Sanskrit Sandhi transitions based on Paninian linguistics. Learn rules, formulas, and examples."
  : lang === "hi"
  ? "पाणिनीय भाषा विज्ञान के आधार पर संस्कृत संधि परिवर्तनों का एक व्यापक ध्वन्यात्मक गाइड। नियम, सूत्र और उदाहरण सीखें।"
  : lang === "ja"
  ? "パーニニ言語学に基づくサンスクリットのサンドゥヒ（連声）変化に関する音韻ガイド。詳細な規則、数式、および具体例を学びます。"
  : "Una guía fonética completa de las transiciones de Sandhi en sánscrito basada en la lingüística paniniana. Aprenda reglas, fórmulas y ejemplos.";

const Body = { en: En, hi: Hi, ja: Ja, es: Es }[lang as "en" | "hi" | "ja" | "es"] ?? En;
---

<Layout lang={lang} title={title} description={desc}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    {/* Navigation link back */}
    <div class="mb-8">
      <a 
        href={`/${lang}/learn`} 
        class="inline-flex items-center space-x-2 text-xs font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 font-latin uppercase tracking-wider"
      >
        <ChevronLeft class="w-4 h-4" />
        <span>{lang === "en" ? "Back to Learning Hub" : lang === "hi" ? "अध्ययन केंद्र पर वापस" : lang === "ja" ? "学習ハブに戻る" : "Volver al Centro de Aprendizaje"}</span>
      </a>
    </div>

    <Body />
    <ArticleByline lang={lang} slug="panini-sandhi-rules" title={title} description={desc} published="2026-07-24" updated="2026-11-18" />
  </div>
</Layout>
